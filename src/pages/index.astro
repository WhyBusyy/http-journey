---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import StepSection from '../components/StepSection.astro';
import Footer from '../components/Footer.astro';
import TwoLaneDiagram from '../components/TwoLaneDiagram';
import ProgressBar from '../components/ProgressBar';
import Waterfall from '../components/Waterfall';
import { steps } from '../data/steps';
import { computeTimeline } from '../lib/timeline';

const { entries, total } = computeTimeline(steps);
---

<Base title={`요청 하나의 ${total}ms`} description="HTTP 요청 하나가 물리적·논리적으로 거치는 길을 따라가 봐요.">
  <ProgressBar total={total} client:load />
  <Hero total={total} />
  <main>
    {
      steps.map((step) => (
        <StepSection step={step}>
          <TwoLaneDiagram slot="diagram" step={step} entry={entries[step.index]} client:visible />
        </StepSection>
      ))
    }
    <section id="overview" class="mx-auto max-w-2xl scroll-mt-16 px-6 py-20">
      <Waterfall steps={steps} entries={entries} total={total} client:visible />
    </section>
  </main>
  <Footer />
</Base>
